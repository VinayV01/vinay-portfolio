<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: static hosting for the built portfolio (copy the contents of dist/ to the site root). -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
    <httpCompression>
      <dynamicTypes><add mimeType="application/javascript" enabled="true" /></dynamicTypes>
    </httpCompression>
  </system.webServer>
</configuration>
